:root {
    --primary-color: #0d1b2a;
    --secondary-color: #1b263b;
    --accent-color: #f77f00;
    --text-light: #f8f9fa;
    --text-dark: #212529;
    --bg-light: #e9ecef;
    --card-bg: #ffffff;
    --success-color: #2a9d8f;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Segoe UI', sans-serif;
}

body {
    background-color: var(--bg-light);
    color: var(--text-dark);
    padding: 2rem;
}

.container {
    max-width: 1200px;
    margin: 0 auto;
}

h2 {
    color: var(--primary-color);
    margin-bottom: 1.5rem;
    border-left: 5px solid var(--accent-color);
    padding-left: 10px;
}

/* Formulários */
.form-group {
    margin-bottom: 1.2rem;
}

.form-group label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 500;
}

.form-group input, .form-group select {
    width: 100%;
    padding: 0.75rem;
    border: 1px solid #ced4da;
    border-radius: 4px;
    font-size: 1rem;
}

/* Botões */
.btn {
    display: inline-block;
    width: 100%;
    padding: 0.75rem;
    background-color: var(--primary-color);
    color: white;
    border: none;
    border-radius: 4px;
    font-size: 1rem;
    font-weight: bold;
    cursor: pointer;
    text-align: center;
    text-decoration: none;
    transition: background 0.3s;
}

.btn:hover { background-color: var(--secondary-color); }
.btn-accent { background-color: var(--accent-color); }
.btn-accent:hover { background-color: #d66f00; }
